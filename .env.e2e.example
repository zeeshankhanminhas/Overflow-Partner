# Point at your chosen environment. Do not use your real OP customer data for write tests.
OP_E2E_BASE_URL=http://127.0.0.1:3000

# Optional operator navigation suite: dedicated account, NOT your primary admin account
OP_E2E_EMAIL=
OP_E2E_PASSWORD=

# Optional secure-link suites. These are tokens for identified test records ONLY.
# Opening either link updates its opened/last-opened audit values.
OP_E2E_TEST_DATA_CONFIRMED=0
OP_E2E_ALLOW_TOKEN_OPEN=0
OP_E2E_INTAKE_URL=
OP_E2E_PARTNER_REVIEW_URL=
# Only enable when the dedicated partner review has a known shared file.
OP_E2E_EXPECT_PARTNER_FILE=0

# Optional local screenshots (can include confidential business data).
OP_E2E_CAPTURE_UI=0

# Destructive partner submission: only for a disposable isolated environment.
# OP_E2E_MUTATION_ORIGIN must exactly equal the origin of OP_E2E_BASE_URL.
OP_E2E_ENVIRONMENT=
OP_E2E_ALLOW_MUTATIONS=0
OP_E2E_MUTATION_ORIGIN=
